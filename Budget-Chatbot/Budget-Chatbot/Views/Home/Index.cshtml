@{
    ViewData["Title"] = "Budget Chatbot";
    Layout = null;
    var username = ViewBag.Username as string ?? "Użytkownik";
    var userInitial = username[0].ToString().ToUpper();
}
<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Budget Chatbot</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body data-style="dark-gray">

    <aside class="sidebar">
        <div class="sidebar-header">
            <span class="app-title">Budget Chatbot</span>
        </div>

        <button class="new-chat-btn" id="newChatBtn">+ Nowy chat</button>

        <div class="sidebar-section-label">Historia</div>
        <div class="chat-list" id="chatList"></div>

        <div class="sidebar-footer">
            <div class="sidebar-footer-btn" id="btnCharts">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                    <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
                </svg>
                Wykresy
            </div>
            @if (ViewBag.Role as string == "Admin")
            {
                <a href="/Admin" class="sidebar-footer-btn" style="text-decoration:none;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                    Panel admina
                </a>
            }

            <div class="sidebar-user-row">
                <div class="sidebar-user-avatar">@userInitial</div>
                <div class="sidebar-user-name">@username</div>
                <form method="post" action="/Account/Logout" style="margin-left:auto">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="sidebar-logout-btn" title="Wyloguj">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                            <polyline points="16 17 21 12 16 7" />
                            <line x1="21" y1="12" x2="9" y2="12" />
                        </svg>
                    </button>
                </form>
            </div>
        </div>
    </aside>

    <main class="main">

        <div class="topbar">
            <span class="topbar-title" id="topbarTitle">Chat</span>
            <div class="topbar-actions">
                <div class="style-switcher">
                    <div class="style-dot active" data-s="dark-gray" title="Dark Gray"></div>
                    <div class="style-dot" data-s="coral" title="Coral"></div>
                    <div class="style-dot" data-s="crimson" title="Crimson"></div>
                    <div class="style-dot" data-s="neon" title="Neon"></div>
                </div>
                <div class="font-size-control">
                    <label class="font-size-label">Czcionka</label>
                    <input class="font-size-input" id="fontSizeInput" type="number" min="2" max="64" step="1" value="14" title="Rozmiar czcionki (px)" />
                </div>
                <div class="topbar-user">
                    <div class="topbar-user-avatar">@userInitial</div>
                    <span class="topbar-user-name">@username</span>
                </div>
            </div>
        </div>

        <div class="help-popup" id="helpPopup">
            <div class="help-title">Jak używać Budget Chatbot?</div>
            <div class="help-content">
Wpisz wydatek lub wpłatę oraz kwotę w złotówkach w dowolnym chacie a bot zapisze Twoją wiadomość do bazy.
Jeśli błędnie wpiszesz wiadomość bot poinformuje Cię o błędzie a informacja nie zostanie wpisana do bazy.
Wiadomość możesz wysłać wciskając "Enter" lub ikonkę samolotu po prawej stronie paska wpisywania wiadomości.
W lewym dolnym rogu znajdziesz ikony Wykresy oraz Wyloguj.
Przycisk "Wykresy" przekieruje Cię do sekcji wykresów Twoich wydatków, które możesz dostosować filtrując dane na osi czasu (kalendarz na górze).
Przycisk Wyloguj wyloguje Cię z konta zapamiętując Twoją historię wraz z wydatkami.
W prawym górnym rogu znajdziesz panel wyglądu strony oraz panel czcionki.
Po naciśnięciu jednego z kolorów na pasku kolor strony zmieni się automatycznie.
Panel czcionki pozwala na ręczną (poprzez wpisanie) lub automatyczną (przeklikując strzałki) zmianę czcionki strony.
            </div>
        </div>

        <div class="page active" id="pageChatWrapper">
            <div class="chat-area" id="chatArea">
                <div class="messages-wrapper" id="messagesWrapper"></div>
            </div>

            <div class="input-bar">
                <div class="input-inner">
                    <button class="info-btn" id="infoBtn" title="Pomoc">I</button>
                    <div class="input-wrap">
                        <textarea id="messageInput" rows="1" placeholder="Napisz wydatek, np. 'Kawa 12 zł'…"></textarea>
                    </div>
                    <button class="send-btn" id="sendBtn" title="Wyślij">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14">
                            <line x1="22" y1="2" x2="11" y2="13" />
                            <polygon points="22 2 15 22 11 13 2 9 22 2" />
                        </svg>
                    </button>
                </div>
            </div>
        </div>

    </main>

    <div class="overlay" id="overlay"></div>
    <div class="toast" id="toast">Zapisano</div>

    <script>
        var APP_USERNAME = '@username';
        var APP_USER_INITIAL = '@userInitial';
    </script>
    <script src="~/js/site.js"></script>
</body>
</html>
