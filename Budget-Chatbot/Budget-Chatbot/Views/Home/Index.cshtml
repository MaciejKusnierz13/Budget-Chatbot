@{
    ViewData["Title"] = "Budget Chatbot";
    Layout = null;
    var username = ViewBag.Username as string ?? "Użytkownik";
    var userInitial = username[0].ToString().ToUpper();
}
<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Budget Chatbot</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body data-style="dark-gray">

    <aside class="sidebar">
        <div class="sidebar-header">
            <span class="app-title">Budget Chatbot</span>
        </div>

        <button class="new-chat-btn" id="newChatBtn">+ Nowy chat</button>

        <div class="sidebar-section-label">Historia</div>
        <div class="chat-list" id="chatList"></div>

        <div class="sidebar-footer">
            <div class="sidebar-footer-btn" id="btnCharts">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                    <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
                </svg>
                Wykresy
            </div>

            <div class="sidebar-user-row">
                <div class="sidebar-user-avatar">@userInitial</div>
                <div class="sidebar-user-name">@username</div>
                <form method="post" action="/Account/Logout" style="margin-left:auto">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="sidebar-logout-btn" title="Wyloguj">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                            <polyline points="16 17 21 12 16 7" />
                            <line x1="21" y1="12" x2="9" y2="12" />
                        </svg>
                    </button>
                </form>
            </div>
        </div>
    </aside>

    <main class="main">

        <div class="topbar">
            <span class="topbar-title" id="topbarTitle">Chat</span>
            <div class="topbar-actions">
                <div class="style-switcher">
                    <div class="style-dot active" data-s="dark-gray" title="Dark Gray"></div>
                    <div class="style-dot" data-s="coral" title="Coral"></div>
                    <div class="style-dot" data-s="crimson" title="Crimson"></div>
                    <div class="style-dot" data-s="neon" title="Neon"></div>
                </div>
                <div class="topbar-user">
                    <div class="topbar-user-avatar">@userInitial</div>
                    <span class="topbar-user-name">@username</span>
                </div>
            </div>
        </div>

        <div class="help-popup" id="helpPopup">
            <div class="help-title">Jak używać Budget Chatbot?</div>
            <div class="help-content">
                Wpisz wydatek lub przychód naturalnym językiem.

                Przykłady:
                • "Kawa 12 zł"
                • "Bilet tramwajowy 4.40"
                • "Wypłata 5000 zł"

                Bot automatycznie rozpozna kwotę,
                kategorię i opis, a następnie
                zapisze transakcję w bazie.

                Jeśli bot nie zrozumie wiadomości,
                dostaniesz komunikat błędu.
                Spróbuj napisać dokładniej.
            </div>
        </div>

        <div class="page active" id="pageChatWrapper">
            <div class="chat-area" id="chatArea">
                <div class="messages-wrapper" id="messagesWrapper"></div>
            </div>

            <div class="input-bar">
                <div class="input-inner">
                    <button class="info-btn" id="infoBtn" title="Pomoc">I</button>
                    <div class="input-wrap">
                        <textarea id="messageInput" rows="1" placeholder="Napisz wydatek, np. 'Kawa 12 zł'…"></textarea>
                    </div>
                    <button class="send-btn" id="sendBtn" title="Wyślij">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14">
                            <line x1="22" y1="2" x2="11" y2="13" />
                            <polygon points="22 2 15 22 11 13 2 9 22 2" />
                        </svg>
                    </button>
                </div>
            </div>
        </div>

    </main>

    <div class="overlay" id="overlay"></div>
    <div class="toast" id="toast">Zapisano</div>

    <script>
        var APP_USERNAME = '@username';
        var APP_USER_INITIAL = '@userInitial';
    </script>
    <script src="~/js/site.js"></script>
</body>
</html>
