@{
    ViewData["Title"] = "Wykresy";
    var userId = ViewBag.UserId ?? 1;
}

<div style="padding: 24px;">
    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:20px;">
        <h4 style="margin:0; font-weight:600;">Analiza Budżetu</h4>
        <a href="/" style="font-size:13px; color:#888; text-decoration:none;">← Wróć do chatu</a>
    </div>

    <div style="display:flex; gap:12px; align-items:flex-end; margin-bottom:24px; flex-wrap:wrap;">
        <div>
            <label style="font-size:12px; color:#888; display:block; margin-bottom:4px;">Od</label>
            <input type="date" id="startDate" style="padding:7px 10px; border:1px solid #333; border-radius:6px; background:#1a1a1a; color:#e0e0e0; font-size:13px; outline:none;" />
        </div>
        <div>
            <label style="font-size:12px; color:#888; display:block; margin-bottom:4px;">Do</label>
            <input type="date" id="endDate" style="padding:7px 10px; border:1px solid #333; border-radius:6px; background:#1a1a1a; color:#e0e0e0; font-size:13px; outline:none;" />
        </div>
        <button onclick="loadAllCharts()" style="padding:8px 18px; background:#2a2a2a; color:#e0e0e0; border:1px solid #333; border-radius:6px; font-size:13px; cursor:pointer;">
            Generuj wykresy
        </button>
    </div>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:20px;">
        <div style="background:#1a1a1a; border:1px solid #2a2a2a; border-radius:8px; padding:20px;">
            <div style="font-size:13px; font-weight:600; margin-bottom:16px; color:#e0e0e0;">Wydatki i Przychody wg Kategorii</div>
            <div style="position:relative; height:260px;">
                <canvas id="categoryBarChart"></canvas>
            </div>
        </div>

        <div style="background:#1a1a1a; border:1px solid #2a2a2a; border-radius:8px; padding:20px;">
            <div style="font-size:13px; font-weight:600; margin-bottom:16px; color:#e0e0e0;">Miesięczne Podsumowanie</div>
            <div style="position:relative; height:260px;">
                <canvas id="summaryBarChart"></canvas>
            </div>
        </div>
    </div>

    <div style="background:#1a1a1a; border:1px solid #2a2a2a; border-radius:8px; padding:20px;">
        <div style="font-size:13px; font-weight:600; margin-bottom:16px; color:#e0e0e0;">Wydatki w Czasie (Podział na Kategorie)</div>
        <div style="position:relative; height:300px;">
            <canvas id="categoryLineChart"></canvas>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    let catChart = null;
    let sumChart = null;
    let lineChart = null;
    const userId = @userId;

    const chartDefaults = {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
            legend: {
                labels: { color: '#aaa', font: { size: 11 } }
            }
        },
        scales: {
            x: {
                ticks: { color: '#777', font: { size: 10 } },
                grid: { color: '#222' }
            },
            y: {
                beginAtZero: true,
                ticks: { color: '#777', font: { size: 10 } },
                grid: { color: '#222' }
            }
        }
    };

    async function loadAllCharts() {
        const start = document.getElementById('startDate').value;
        const end = document.getElementById('endDate').value;
        const queryParams = (start && end) ? `?startDate=${start}&endDate=${end}` : "";

        await Promise.all([
            loadCategoryBarChart(queryParams),
            loadSummaryBarChart(queryParams),
            loadCategoryLineChart(queryParams)
        ]);
    }

    async function loadCategoryBarChart(queryParams) {
        const res = await fetch(`/api/reports/advanced/category-bar/${userId}${queryParams}`);
        const data = await res.json();

        if (catChart) catChart.destroy();

        const ctx = document.getElementById('categoryBarChart').getContext('2d');
        catChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: data.map(d => d.categoryName),
                datasets: [{
                    label: 'Kwota (PLN)',
                    data: data.map(d => d.amount),
                    backgroundColor: data.map(d => d.isExpense ? 'rgba(220, 80, 80, 0.75)' : 'rgba(60, 180, 100, 0.75)'),
                    borderRadius: 4
                }]
            },
            options: { ...chartDefaults }
        });
    }

    async function loadSummaryBarChart(queryParams) {
        const res = await fetch(`/api/reports/advanced/summary-bar-time/${userId}${queryParams}`);
        const data = await res.json();

        if (sumChart) sumChart.destroy();

        const ctx = document.getElementById('summaryBarChart').getContext('2d');
        sumChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: data.map(d => d.period),
                datasets: [
                    { label: 'Przychody', data: data.map(d => d.totalIncomes), backgroundColor: 'rgba(60, 180, 100, 0.75)', borderRadius: 4 },
                    { label: 'Wydatki', data: data.map(d => d.totalExpenses), backgroundColor: 'rgba(220, 80, 80, 0.75)', borderRadius: 4 }
                ]
            },
            options: { ...chartDefaults }
        });
    }

    async function loadCategoryLineChart(queryParams) {
        const res = await fetch(`/api/reports/advanced/category-line-time/${userId}${queryParams}`);
        const data = await res.json();

        if (lineChart) lineChart.destroy();

        const labels = [...new Set(data.map(item => item.date))].sort();
        const categories = [...new Set(data.map(item => item.category))];

        const colors = {
            'Jedzenie':  'rgb(220, 80, 80)',
            'Transport': 'rgb(230, 180, 50)',
            'Rozrywka':  'rgb(80, 130, 220)',
            'Wypłata':   'rgb(60, 180, 100)'
        };

        const datasets = categories.map(cat => {
            const chartData = labels.map(date => {
                const found = data.find(item => item.date === date && item.category === cat);
                return found ? found.total : 0;
            });

            return {
                label: cat,
                data: chartData,
                borderColor: colors[cat] || '#888',
                backgroundColor: 'transparent',
                tension: 0.3,
                pointRadius: 2,
                borderWidth: 2
            };
        });

        const ctx = document.getElementById('categoryLineChart').getContext('2d');
        lineChart = new Chart(ctx, {
            type: 'line',
            data: { labels: labels, datasets: datasets },
            options: { ...chartDefaults }
        });
    }

    document.addEventListener("DOMContentLoaded", loadAllCharts);
</script>
